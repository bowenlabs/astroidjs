---
// The home page—an editable `pages` row rendered in place. Reads the published
// `home` row for the public view; in edit mode it reads the latest DRAFT so an
// editor's in-progress edits resume. The <Editable> fields carry the markers the
// Louise client turns into inline editors; saves stage a draft (versionedPageId),
// and Publish promotes it. Seed the row once with `seed/home.seed.sql`.
import Editable from "astroidjs/components/Editable.astro";
import { sanitizeAstroidRichHtml } from "astroidjs/components/rich-html";
import Sections from "astroidjs/components/Sections.astro";
import { env } from "cloudflare:workers";
import Hero from "../components/Hero.astro";
import Site from "../layouts/Site.astro";
import { readPage } from "../lib/pages";

export const prerender = false;

const { editMode } = Astro.locals;

// Edge caching (ADR 0004). Opting in emits `Cloudflare-CDN-Cache-Control`, which
// the worker's `withEdgeCache` layer reads as "store this", then strips.
//
// Both conditions matter. Edit mode must NEVER opt in—a cached editor render
// would carry draft content and the inline-edit hooks into the shared public
// entry. And the var is off by default because `caches.default` survives
// Cloudflare Dev Mode and Purge Everything; walk the activation runbook in
// docs/adr/0004-edge-caching.md on a preview deploy before turning it on.
//
// `set(false)` is the safe state, not merely the "off" one: it emits `no-store`,
// so nothing downstream caches this HTML either.
if (editMode || env.ASTROID_EDGE_CACHE !== "true") {
  Astro.cache.set(false);
} else {
  // Short on purpose: `caches.default` is per-colo with no global purge, so this
  // max-age is the real worldwide freshness floor after a publish.
  Astro.cache.set({ maxAge: 60 });
}

// `seo_*` are the page's SEO overrides, deliberately separate from `title`—which
// is the on-page H1. The home page passes NO title to <Site>, so <title>
// is the site-wide default ("Acme Coffee", not "Acme Coffee | Acme Coffee");
// set `seo_title` on the row to override just the head.
//
// `requireLive: false`: an unpublished home keeps rendering rather than turning
// the site's front door into a 404. Every other page is visitor-visible only
// while it's live (src/pages/[...slug].astro).
const page = await readPage(env, "home", { editMode, requireLive: false });
const title = page?.title ?? "__BRAND_NAME__";
const sections = page?.sections ?? [];
---

<Site
  title={page?.row.seo_title ?? undefined}
  description={page?.row.seo_description ?? undefined}
  ogImage={page?.row.og_image ?? undefined}
  noindex={Boolean(page?.row.noindex)}
  versionedPageId={page?.row.id}
  sections={sections}
>
  {
    page ? (
      <main>
        {/* The page-builder sections, edited on-canvas. <Sections> resolves every
            image's alt/caption from the media registry in ONE query for the whole
            page, then hands each section its own path so `data-louise-node`
            markers land at the right depth. */}
        <Sections items={sections} db={env.DB} mediaBase={env.MEDIA_URL} />

        <div class="mx-auto max-w-3xl px-6 py-16">
        <Editable as="h1" collection="pages" key={page.row.id} field="title" class="text-5xl font-bold">
          {title}
        </Editable>
        <Editable as="div" collection="pages" key={page.row.id} field="body" type="richtext" class="prose mt-6 max-w-none">
          <Fragment set:html={sanitizeAstroidRichHtml(page.body, { mediaBase: env.MEDIA_URL })} />
        </Editable>
        </div>
      </main>
    ) : (
      <main>
        <Hero title={title} tagline="Seed the home page (seed/home.seed.sql) to edit it in place." />
      </main>
    )
  }
</Site>
