---
// Editor sign-in. Emails a magic link (Better Auth) to an allowlisted editor;
// clicking it starts a session and lands on `/?louise` (edit mode on). The gate
// is enumeration-safe — the response is identical whether or not the email is an
// editor — so the UI always says "check your email".
import { env } from "cloudflare:workers";
import { turnstileSiteKey } from "louise-toolkit/auth";
import Site from "../layouts/Site.astro";

export const prerender = false;

// Turnstile, rendered ONLY when a real (non-test) site key is set.
//
// This has to match the server exactly. `getLouiseAuth` registers Better Auth's
// captcha plugin on /sign-in/magic-link the moment BOTH halves of the pair are
// real, and that plugin rejects any request without an `x-captcha-response`
// header. So a page that never rendered a widget meant provisioning Turnstile —
// which .env.example openly invites you to do — locked the owner out of their
// own sign-in, with a 403 and no clue why.
//
// `turnstileSiteKey` returns null for the always-passing TEST key, which is the
// same condition `activeCaptchaSecret` uses server-side. One shared rule, so the
// widget appears exactly when the server starts demanding a token.
const siteKey = turnstileSiteKey(env);
---

{/* noindex: an editor sign-in page has nothing for a search result to offer. */}
<Site title="Sign in" noindex>
  <main class="hero min-h-screen">
    <div class="hero-content w-full max-w-sm">
      <form id="magic" class="card w-full bg-base-200 shadow-sm">
        <div class="card-body gap-4">
          <h1 class="card-title">Sign in to edit</h1>
          <label class="form-control w-full">
            <span class="label-text mb-1">Editor email</span>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              class="input input-bordered w-full"
            />
          </label>
          {
            siteKey && (
              /* Rendered explicitly by the script below, which reads the key
                 from here — a processed script can't take `define:vars`. */
              <div id="captcha" data-sitekey={siteKey} />
            )
          }
          <button type="submit" class="btn btn-primary">Email me a sign-in link</button>
          <p id="msg" class="text-sm opacity-70" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </main>

  {/* Processed (NOT is:inline) so Astro's security.csp hashes it into script-src,
      and bundles the import. The widget's own script is loaded by
      `renderTurnstile` from challenges.cloudflare.com, which the CSP already
      allows for script, frame and connect (astroidSecurity). */}
  <script>
    import { renderTurnstile, type TurnstileWidget } from "louise-toolkit/forms/turnstile";

    const form = document.getElementById("magic") as HTMLFormElement | null;
    const msg = document.getElementById("msg");
    const captcha = document.getElementById("captcha");

    // Absent when no real site key is set — then the server's captcha plugin is
    // off too, and the request goes without a token.
    let widget: TurnstileWidget | null = null;
    const ready = captcha?.dataset.sitekey
      ? renderTurnstile(captcha, { siteKey: captcha.dataset.sitekey, size: "flexible" })
          .then((w) => {
            widget = w;
          })
          .catch(() => {
            // The server will refuse a request without a token, so say so now
            // rather than after the owner has typed their email.
            if (msg) msg.textContent = "The sign-in check didn't load — reload the page to try again.";
          })
      : Promise.resolve();

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const input = document.getElementById("email") as HTMLInputElement | null;
      const email = input?.value.trim();
      if (!email || !msg) return;
      await ready;
      if (captcha && !widget) return; // the load failure is already on screen
      msg.textContent = "Sending…";
      // Better Auth's captcha plugin reads the token from the `x-captcha-response`
      // HEADER (not the body), and rejects the request outright when it's missing.
      const token = widget?.token();
      try {
        const res = await fetch("/api/auth/sign-in/magic-link", {
          method: "POST",
          headers: {
            "content-type": "application/json",
            ...(token ? { "x-captcha-response": token } : {}),
          },
          body: JSON.stringify({ email, callbackURL: "/?louise" }),
        });
        // Enumeration-safe either way: a non-editor gets the same 200 as an
        // editor, so a failure here is the captcha, a rate limit, or an outage.
        msg.textContent = res.ok
          ? "If that email is an editor, a sign-in link is on its way."
          : "That didn't go through — please try again.";
      } catch {
        msg.textContent = "Something went wrong — please try again.";
      } finally {
        // A token is single-use, and this one is spent whatever happened. Without
        // a fresh one, "send it again" posts the spent token and is refused.
        widget?.reset();
      }
    });
  </script>
</Site>
