// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the editor-free app shape > generates the trio it always has 1`] = `
{
  "src/middleware.ts": "// Generated by astroidjs—do not hand-edit.
// The shared Louise middleware: rate-limit the unauthenticated POST surfaces,
// then (this app has no editor, so there's no session to resolve) apply
// content-freshness + transport-security headers, and rewrite the style-src of
// the CSP header Astro's security.csp emits so Louise's data-driven inline
// styles + inlined data: brand font are allowed.
import { env } from "cloudflare:workers";
import { createLouiseMiddleware } from "@louise-toolkit/astro";
import { astroidRateRules } from "astroidjs";
import astroidConfig from "../astroid.config.js";

// Rate-limit the public, unauthenticated POST surface, keyed by client IP
// (fixed-window KV counter that fails open). Derived from your config: the
// versioned API under /api/v1, plus the portal credential surfaces and checkout
// when those are enabled. Add your own via \`security.rateRules\` in the config—
// they're matched first, so they can also override a default's budget.
// \`env.RL\` is read per request (a getter)—a KV binding is only valid in
// request scope.
const RATE_RULES = astroidRateRules(astroidConfig);

export const onRequest = createLouiseMiddleware({
  // No editor (\`editor: false\`), so no request resolves to one and edit
  // mode never turns on.
  resolveEditor: () => null,
  rateLimit: { rules: RATE_RULES, kv: () => env.RL },
  // The same deny-by-default gate for /api/louise routes that reach Astro—
  // anything the worker's routes didn't answer. A second check behind the
  // worker's gate: with no editor, it refuses all but the public routes.
  apiGate: true,
  // Rewrite Astro's hash-based style-src (owned by astroidSecurity in
  // astro.config.mjs) to permit Louise's data-driven style="" + editor styles.
  cspStyleSrc: "'self' 'unsafe-inline'",
});
",
  "src/schema.ts": "// Generated by astroidjs—do not hand-edit.
// Source: your defineAstroid config. This app has no editor (\`editor: false\`),
// so it owns no content tables. To read one that another app owns, such as
// \`siteSettings\`, import it from "louise-toolkit/db" where you query it.

// Incident capture's tables (louise-toolkit ADR 0022): the generated worker
// counts failures into \`incidents\` and keeps dead-lettered queue messages in
// \`dead_letters\`.
export { deadLetters, incidents } from "louise-toolkit/incidents";

// Site-owned tables, declared in src/schema.site.ts and re-exported here so
// drizzle-kit and the worker see them. Empty until the app adds one.
export * from "./schema.site.js";
",
  "src/worker.ts": "// Generated by astroidjs—do not hand-edit.
// Source: your defineAstroid config. This app has no editor (\`editor: false\`),
// so it serves no editor routes and resolves no editor session.
import { handle } from "@astrojs/cloudflare/handler";
import { d1Check, statusRoute } from "louise-toolkit/editor";
import { analyticsIncidents, d1Incidents } from "louise-toolkit/incidents";
import { composeWorker, type WorkerRoute, withEdgeCache } from "louise-toolkit/worker";

// --- public status ---------------------------------------------------------
// What statusRoute answers an outside probe with: 200 when every check
// passes, 503 when any fails, throws, or takes over two seconds. Anyone can
// make these run, so each is one cheap read, and a burst of probes reuses one
// result per isolate for STATUS_REUSE_MS.
const STATUS_REUSE_MS = 10_000;
const STATUS_CHECKS = {
  // D1 answers \`SELECT 1\`.
  d1: d1Check((env: CloudflareEnv) => env.DB),
};

const routes: WorkerRoute<CloudflareEnv>[] = [
  // Public status for an outside probe (GET/HEAD /api/louise/status). A
  // publicRoute, so the gate below lets an anonymous probe through.
  statusRoute({ checks: STATUS_CHECKS, reuseMs: STATUS_REUSE_MS }),
];

// --- incidents --------------------------------------------------------------
// Every failure this worker sees becomes an incident: counted into the site's
// own D1 (the \`incidents\` table), and into Analytics Engine for counts over
// time (louise-toolkit ADR 0022). These bindings are optional. A site whose
// wrangler.jsonc predates them still type-checks, and a sink skips what isn't
// bound.
type IncidentBindings = {
  INCIDENT_EVENTS?: AnalyticsEngineDataset;
  CF_VERSION_METADATA?: WorkerVersionMetadata;
};
const incidentBindings = (env: CloudflareEnv) => env as CloudflareEnv & IncidentBindings;

export default composeWorker<CloudflareEnv>({
  routes,
  // No editor, so no request under /api/louise resolves to one. The gate
  // refuses everything there except the public status probe, and gives route
  // responses the security headers the middleware never sees.
  gate: { resolveEditor: () => null },
  // The SSR fallback, in the Worker cache (ADR 0004). It stores only a
  // response that opts in with \`Astro.cache.set(...)\`, and it strips the CDN
  // directive from every other one, so Cloudflare's cookie-blind edge cache
  // never stores a signed-in customer's page.
  fetch: withEdgeCache((request, env, ctx) => handle(request, env, ctx)),
  // Incident capture (louise-toolkit ADR 0022). A throw is reported, then
  // re-thrown, so responses don't change; the sinks run after the response.
  onIncident: {
    sinks: [
      // The record: one row per failure, with a count, in the site's own D1.
      d1Incidents((env: CloudflareEnv) => env.DB),
      analyticsIncidents((env: CloudflareEnv) => incidentBindings(env).INCIDENT_EVENTS),
    ],
    release: (env) => incidentBindings(env).CF_VERSION_METADATA?.id,
  },
});
",
}
`;
