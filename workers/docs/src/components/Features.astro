---
// The feature grid on the splash page. Starlight's <Card> only takes its own
// icon set, and every icon on the stack is Phosphor, so this renders the grid
// itself. The SVGs are imported raw from @phosphor-icons/core and inlined, the
// same way the Louise editor client does it, so they inherit `currentColor`.
import fileTs from "@phosphor-icons/core/assets/bold/file-ts-bold.svg?raw";
import palette from "@phosphor-icons/core/assets/bold/palette-bold.svg?raw";
import sections from "@phosphor-icons/core/assets/bold/squares-four-bold.svg?raw";
import stack from "@phosphor-icons/core/assets/bold/stack-bold.svg?raw";
import storefront from "@phosphor-icons/core/assets/bold/storefront-bold.svg?raw";
import terminal from "@phosphor-icons/core/assets/bold/terminal-window-bold.svg?raw";

const icons = { fileTs, palette, sections, stack, storefront, terminal };

interface Props {
  items: { icon: keyof typeof icons; title: string; body: string }[];
}

const { items } = Astro.props;
---

<ul class="features not-content">
  {
    items.map(({ icon, title, body }) => (
      <li>
        <span class="icon" aria-hidden="true" set:html={icons[icon]} />
        <h3>{title}</h3>
        <p>{body}</p>
      </li>
    ))
  }
</ul>

<style>
  .features {
    display: grid;
    /* Three across on a wide screen, so six items land as an even 3 × 2. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  li {
    padding: 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background-color: var(--sl-color-black);
  }
  .icon {
    display: inline-flex;
    padding: 0.5rem;
    border-radius: 0.5rem;
    color: var(--sl-color-accent-high);
    background-color: var(--sl-color-accent-low);
  }
  .icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }
  h3 {
    margin: 0.75rem 0 0.25rem;
    font-size: var(--sl-text-lg);
    font-weight: 800;
    font-stretch: 110%;
    color: var(--sl-color-white);
  }
  p {
    margin: 0;
    color: var(--sl-color-gray-2);
    line-height: 1.55;
  }
</style>
