{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Policy lives in bowenlabs/louise-toolkit's `default.json`, which every
  // BowenLabs repo extends — grouping, schedules, vulnerability handling, and the
  // "the toolkit" group that keeps louise-toolkit, @louise-toolkit/astro,
  // astroidjs and create-astroid moving together.
  //
  // Only rules that are genuinely specific to THIS repo belong below. Anything
  // another repo would also want belongs in the shared preset instead.
  extends: ["github>bowenlabs/louise-toolkit"],

  ignorePaths: [
    // NOT source. `create-astroid/template/` is the scaffold's template set: its
    // files carry `__ASTROID_*__` placeholders, several are not valid TypeScript
    // standalone, and the toolkit versions in its package.json are sentinels
    // (`0.0.0-replaced-at-scaffold`) that create-astroid DERIVES from its own
    // resolved dependencies at pack time.
    //
    // `scripts/ci/checks/scaffold-versions.mjs` fails the build if those become
    // hardcoded literals, which is precisely what a well-meaning Renovate PR
    // would write. The scaffold smoke test is the only thing that would catch the
    // damage, and it runs after the PR is already open. Leave it alone; the
    // template is updated by the release, not by a bot.
    "packages/create-astroid/template/**",
  ],

  packageRules: [
    {
      // A bump to a published peer dependency is an API change for every
      // scaffolded site, not a routine upgrade. Never let one ride along in a
      // group where it would be reviewed as background noise.
      matchDepTypes: ["peerDependencies"],
      matchFileNames: ["packages/astroid/package.json"],
      groupName: null,
      labels: ["dependencies", "published-api"],
      addLabels: ["published-api"],
    },
    {
      // The toolkit is this repo's whole foundation. Its updates are the ones
      // most likely to need a code change here, so they arrive on their own and
      // promptly rather than batched into Monday's group.
      matchPackageNames: ["louise-toolkit", "@louise-toolkit/astro"],
      groupName: null,
      schedule: ["at any time"],
      labels: ["dependencies", "toolkit"],
    },
  ],
}
